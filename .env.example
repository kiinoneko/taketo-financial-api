# 武豊町 財政分析API - 環境設定

# OpenAI API Settings
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o

# Analysis Settings
ANALYSIS_YEAR=2024

# Logging
LOG_LEVEL=INFO

# API Settings
API_HOST=127.0.0.1
API_PORT=8000

# Taketoyo Town URL
TAKETOYO_BASE_URL=https://www.town.taketoyo.lg.jp
TAKETOYO_BUDGET_PATH=/shisei/zaisei/

# Scraper Settings
REQUEST_TIMEOUT=30
RETRY_ATTEMPTS=3
RETRY_DELAY=2
